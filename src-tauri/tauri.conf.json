{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sistema Solar 3D",
  "version": "2.0.0",
  "identifier": "com.sistemasolar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sistema Solar 3D — Observatorio Astrofísico",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Simulador del Sistema Solar 3D con astrofísica",
    "longDescription": "Observatorio astrofísico interactivo: mecánica kepleriana y N-cuerpos, termodinámica estelar, geología planetaria y laboratorio de relatividad Kerr.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
